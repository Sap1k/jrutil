        "detour": "výluka (diversion) timetable"
      }
    },
    "shape_generation": {
      "values": {
        "source": "taken from a source feed",
        "compiler": "generated by JrUtil",
        "motis": "generated by the MOTIS route-shapes companion"
      }
    },
    "note_kind": {
      "values": {
        "route_information": "JDF route information text",
        "timetable_note": "JDF Caskody note or designation, with or without text",
        "reservation_note": "JDF Mistenky",
        "czptt_central_note": "CZPTT central note (type in service_note_type, display text in label)",
