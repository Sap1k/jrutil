  "namespaces": {
    "cis:line": {
      "entity_kind": "route",
      "encoding": "CIS line, 6 digits zero-padded",
      "example": "582492"
    },
    "cis:line_trip": {
      "entity_kind": "trip",
      "encoding": "CIS line, ':', CIS trip number in decimal without padding",
      "example": "582492:143"
    },
    "czptt:train_number": {
      "entity_kind": "trip",
      "encoding": "train number in decimal as published",
      "example": "16001"
    },
    "czptt:pa": {
      "entity_kind": "trip",
      "encoding": "CZPTT path identifier, verbatim",
      "example": "Pa:0054:KT----18872A:00:2026"
    },
    "czptt:tr": {
      "entity_kind": "trip",
      "encoding": "CZPTT train identifier, verbatim",
      "example": "Tr:3189:KASO---57501:00:2026"
    },
    "pid:gtfs_trip_id": {
      "entity_kind": "trip",
      "encoding": "PID GTFS trip_id, verbatim",
      "example": "991_12081_260207"
    },
    "pid:gtfs_route_id": {
