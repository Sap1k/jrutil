{
  "serving_schema_version": "5.1",
  "status": "normative",
  "parquet_metadata": {
    "obehy.schema_version": "5.1",
    "obehy.relation": "<relation name>",
    "jrutil.bundle_format": "jrutil-production"
  },
  "compatibility": {
    "version": "major.minor",
    "minor": "adds relations, adds nullable fields at the end of a relation, or adds enumeration values or namespaces; consumers accept any minor of their major, ignore unknown relations and fields, and treat unknown enumeration values as unknown",
    "major": "anything else: removing, renaming or retyping a field or relation, changing a key, or changing the meaning of a value"
  },
  "rules": {
    "dates": "date32, inclusive service dates",
    "times": "signed int32 seconds after noon minus 12 h local time (Europe/Prague) of the service date, as GTFS stop_times; equals the wall-clock reading except on DST change days; values above 86400 continue into the next day",
    "ids": "every primary-key identifier starts with its feed prefix (jdf: or czptt:, and overlay: for regional-overlay entities in the JDF package), so the two packages can share tables; strings are opaque case-sensitive UTF-8",
    "enumerations": "a field with enum takes only the listed values (int16 enums as decimal text keys)",
    "lists": "repeated rows only",
    "row_group_maximum": 65536,
    "row_order": "unspecified; primary keys are unique",
    "gtfs": "gtfs.zip is a pure projection of these relations; feed_info.txt is build metadata passed through from the compiler",
    "provenance": "source ids and snapshot digests are in the manifest; rows keep source_object_id only"
  },
  "enumerations": {
    "location_kind": {
      "values": {
        "stop_place": "rider-facing stop or station",
        "boarding_point": "platform, track or post of one stop place",
        "operational_point": "railway point used for timing and progress, never a passenger stop"
      }
    },
    "location_domain": {
      "values": {
        "surface": "road, tram and urban transit (feed jdf)",
        "heavy_rail": "railway (feed czptt)"
      }
    },
    "coordinate_precision": {
      "values": {
        "exact": "surveyed or catalogued position of this stop place or boarding point",
        "estimated": "position estimated by JrUtil (shown with ` [?]`)",
        "missing": "no usable position; longitude/latitude are null"
      }
    },
    "coordinate_source": {
      "values": {
        "sr70": "SŽ SR70 catalogue",
        "osm": "OpenStreetMap",
        "gapfill": "reviewed jrunify-ext-geodata gapfill",
        "catalogue": "regional stop catalogue in jrunify-ext-geodata",
        "overlay": "regional GTFS overlay source",
        "route_time": "interpolated along the route by scheduled time",
        "route_end": "placed past the last anchor of a route (route-end-north)"
      }
    },
    "route_mode": {
      "values": {
        "bus": "bus",
        "trolleybus": "trolleybus",
        "tram": "tram",
        "metro": "metro",
        "rail": "rail",
        "water": "water",
        "cable": "cable",
        "funicular": "funicular"
      }
    },
    "timetable_kind": {
      "values": {
